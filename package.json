{
    "name": "pavao-discreto",
    "displayName": "Pavão Discreto",
    "description": "Visual-comfort-first VS Code theme with four balanced variants: a deep dimmed dark theme, a warm low-glare light theme, a dimmed Antigravity Dark theme, and a clean Antigravity Light theme. Built for long coding sessions with controlled contrast, muted surfaces, and tuned syntax highlighting for JavaScript, TypeScript, React/JSX/TSX, Python, Shell Script/Bash, Prisma, DBML, and more.",
    "version": "0.8.0",
    "publisher": "BrunoVieira",
    "author": {
        "name": "Bruno Vieira"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "icon": "storage/logo.png",
    "galleryBanner": {
        "color": "#0F1520",
        "theme": "dark"
    },
    "homepage": "https://github.com/vieiraes/pavao-discreto-theme/blob/master/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/vieiraes/pavao-discreto-theme.git"
    },
    "bugs": {
        "url": "https://github.com/vieiraes/pavao-discreto-theme/issues",
        "email": "vieira.es@gmail.com"
    },
    "engines": {
        "vscode": "^1.66.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "bitcapital",
        "okto",
        "vscode-theme",
        "visual-studio-code",
        "accessibility",
        "eye-strain",
        "eye-comfort",
        "low-glare",
        "theme",
        "dimmed",
        "pavao",
        "discreto",
        "readable",
        "dark",
        "light",
        "contrast",
        "pavao-discreto",
        "react",
        "jsx",
        "tsx",
        "react-theme",
        "javascript",
        "typescript",
        "shell",
        "warm",
        "muted",
        "bash",
        "shell-script",
        "devops",
        "automation"
    ],
    "scripts": {
        "check": "node scripts/check-contrast.mjs",
        "package": "npx @vscode/vsce package"
    },
    "contributes": {
        "themes": [
            {
                "label": "Pavao Discreto Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/pavao-discreto-color-theme.json"
            },
            {
                "label": "Pavao Discreto Light",
                "uiTheme": "vs",
                "path": "./themes/pavao-discreto-light-theme.json"
            },
            {
                "label": "Pavao Discreto Antigravity Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/pavao-discreto-antigravity-dark-theme.json"
            },
            {
                "label": "Pavao Discreto Antigravity Light",
                "uiTheme": "vs",
                "path": "./themes/pavao-discreto-antigravity-light-theme.json"
            }
        ]
    }
}
